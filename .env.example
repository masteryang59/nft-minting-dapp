# Local development needs none of these: `npm run dev` uses Hardhat's dev accounts.

# --- Sepolia (or any network added to hardhat.config.ts) ---
# Read through Hardhat's configVariable: set them here as environment variables, or keep them
# encrypted with `npx hardhat keystore set SEPOLIA_PRIVATE_KEY` (recommended for keys).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-key
SEPOLIA_PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=

# Where mint proceeds and royalties go (defaults to the deployer).
PAYOUT_ADDRESS=

# Public URL the collection folder is served from. Used for the metadata `image` URLs
# (npm run collection), the placeholder tokenURI (deploy) and the revealed base URI (reveal).
PUBLIC_BASE_URL=http://localhost:5173

# RPC the browser reads through before a wallet is connected. Never put a keyed RPC URL here:
# it ends up in the public deployment.json. Sepolia defaults to a public endpoint.
PUBLIC_RPC_URL=

# Optional: a dedicated IPFS gateway for ipfs:// metadata in the frontend.
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional: keep Hardhat's cache/ and artifacts/ outside the repo.
HARDHAT_BUILD_DIR=
BATCH_INSERT=enabled
VALIDATE_REQUEST=enabled
BATCH_INSERT=enabled